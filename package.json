{
  "name": "healthcare-ui-revamp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Patient Forms & Records UI revamp — reusable, accessible, responsive React components (React + Vite + SCSS Modules).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 -c storybook",
    "build-storybook": "storybook build -c storybook -o storybook-static"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/ibm-plex-sans": "^5.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "sass": "1.83.0",
    "storybook": "8.6.14",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
